# Copy to config/deploy.env (gitignored) and fill in.
# Image to build and push.
IMAGE=registry.example.com/wamux-http
# Dockerfile target: ffmpeg (voice and video conversion) or default (the
# binary alone).
TARGET=ffmpeg
# ssh destination of the host running the compose project.
DEPLOY_HOST=deploy@server.example.com
# Directory on that host holding compose.yaml and its .env.
DEPLOY_PATH=/srv/wamux-http
